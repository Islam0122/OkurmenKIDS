DJANGO_ENV=development

SECRET_KEY="123"
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=movie_reservation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Web Push for the installed PWA (apps.push, backend/docs/push.md).
# Generate once: python manage.py generate_vapid_keys. Leave empty = push off.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
# PUSH_SHOW_CONTENT=True
# Public website (okurmen-public-website, apps.website, backend/docs/website.md).
# Default: https://okurmen-public-website.vercel.app. Add a custom domain here when it is connected.
# PUBLIC_WEBSITE_ORIGINS=https://okurmen-public-website.vercel.app,https://okurmenkids.kg
# PUBLIC_WEBSITE_URL=https://okurmenkids.kg
# WEBSITE_REQUIRE_APPROVAL=False
