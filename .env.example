DJANGO_ENV=development

SECRET_KEY="123"
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=movie_reservation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production (Railway, DJANGO_ENV=production) — see PRODUCTION_DOMAIN_MIGRATION.md.
# ALLOWED_HOSTS=api.okurmenkids.com,okurmenkids.up.railway.app
# FRONTEND_ORIGINS=https://okurmenkids.com,https://www.okurmenkids.com,https://lms.okurmenkids.com,https://admin.okurmenkids.com
# CORS_EXTRA_ORIGINS=   (more exact origins; localhost is allowed automatically outside production)
# LMS_FRONTEND_URL=https://lms.okurmenkids.com
# Web Push for the installed PWA (apps.push, backend/docs/push.md).
# Generate once: python manage.py generate_vapid_keys. Leave empty = push off.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
# PUSH_SHOW_CONTENT=True
# Public website (okurmen-public-website, apps.website, backend/docs/website.md).
# okurmenkids.com + www are already allowed via FRONTEND_ORIGINS; this keeps the *.vercel.app deployment.
# PUBLIC_WEBSITE_ORIGINS=https://okurmen-public-website.vercel.app
# PUBLIC_WEBSITE_URL=https://okurmenkids.com
# WEBSITE_REQUIRE_APPROVAL=False
