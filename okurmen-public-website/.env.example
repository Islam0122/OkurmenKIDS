# Django backend (the existing LMS). Required. No trailing slash.
VITE_API_URL=https://api.okurmenkids.com
# Where uploaded media (/media/...) is served from. Empty = VITE_API_URL.
VITE_MEDIA_URL=
# The canonical address of this website — canonical URLs, hreflang, sitemap, Open Graph.
# Default (when empty): https://www.okurmenkids.com — HTTPS + www is the one canonical host.
VITE_SITE_URL=https://www.okurmenkids.com
# Demo content for UI development ONLY (clearly marked on every page). Never in production.
VITE_USE_MOCKS=false
# The careers site (apps.recruitment) for the Team page CTA. Default: the LMS /careers. Empty = enrollment CTA instead.
VITE_CAREERS_URL=https://lms.okurmenkids.com/careers
